<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:backgroundTint="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Status Indicator -->
        <View
            android:id="@+id/viewStatus"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/success_green"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Peserta"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <!-- Email -->
            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"/>

            <!-- Ticket ID -->
            <TextView
                android:id="@+id/tvTicketId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ticket ID: ABC123"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"/>

            <!-- Checkin Time -->
            <TextView
                android:id="@+id/tvCheckInTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checked-in: 12:00:00"
                android:textSize="12sp"
                android:textColor="@color/success_green"
                android:layout_marginTop="6dp"/>

            <!-- Gate -->
            <TextView
                android:id="@+id/tvGate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gate: -"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>

            <!-- Tombol Check-In Manual (hanya tampil jika belum check-in) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckIn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Check-In"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                app:cornerRadius="8dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>

        <!-- Ticket Type -->
        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_gravity="center_vertical"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>