<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#4CAF50">

    <TextView
        android:id="@+id/tvBannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ CHECK-IN BERHASIL"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvBannerMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiket berhasil di-check-in"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvBannerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Pemegang Tiket"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvBannerTicketId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TICKET123 - VIP"
        android:textSize="14sp"
        android:textColor="@android:color/white" />

</LinearLayout>